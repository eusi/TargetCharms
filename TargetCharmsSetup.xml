<Ui xmlns="http://www.blizzard.com/wow/ui/">
	<Frame name="TargetCharmsPanelTemplate" virtual="true" hidden="true" parent="UIParent" toplevel="true" frameStrata="DIALOG" enableMouse="true" enableKeyboard="true">
		<Size>
			<AbsDimension x="480" y="570" />
		</Size>
		<Anchors>
			<Anchor point="CENTER" />
		</Anchors>
		<Frames>
			<Button id="1" name="PanelShowButton" inherits="UIPanelButtonTemplate">
				<Size>
					<AbsDimension x="200" y="20" />
				</Size>
				<Anchors>
					<Anchor point="TOP">
						<Offset>
							<AbsDimension x="-75" y="-100" />
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						_G[self:GetName().."Text"]:SetText(TARGETCHARMS_PANEL_SHOW);
					</OnLoad>
					<OnClick>
						ShowSetup();
					</OnClick>
				</Scripts>
			</Button>
			<Button id="1" name="PanelResetButton" inherits="UIPanelButtonTemplate">
				<Size>
					<AbsDimension x="200" y="20" />
				</Size>
				<Anchors>
					<Anchor point="TOP">
						<Offset>
							<AbsDimension x="-75" y="-150" />
						</Offset>
					</Anchor>
				</Anchors>
				<Scripts>
					<OnLoad>
						_G[self:GetName().."Text"]:SetText(TARGETCHARMS_PANEL_RESET);
					</OnLoad>
					<OnClick>
						TargetCharms_Reset();
					</OnClick>
				</Scripts>
			</Button>
		</Frames>
	</Frame>
</Ui>
